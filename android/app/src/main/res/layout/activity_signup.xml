<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_back"
                android:contentDescription="뒤로가기"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:tint="#191F28"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="회원가입"
                android:textColor="#2F6FED"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="청년의 오늘을 응원하는 청년 플랫폼"
                android:textColor="#555555"
                android:textSize="15sp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <!-- 아이디 입력칸 -->
            <EditText
                android:id="@+id/etSignupId"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/edittext_background"
                android:hint="아이디"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="text"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <!-- 이메일 입력칸 -->
            <EditText
                android:id="@+id/etSignupEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_background"
                android:hint="이메일"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textEmailAddress"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <!-- 비밀번호 -->
            <EditText
                android:id="@+id/etSignupPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_background"
                android:hint="비밀번호 (영문, 숫자, 특수문자 8자 이상)"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textPassword"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <!-- 비밀번호 확인 -->
            <EditText
                android:id="@+id/etSignupPasswordCheck"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_background"
                android:hint="비밀번호 확인"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textPassword"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <include
                layout="@layout/view_signup_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <!-- 회원가입 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="회원가입"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/logo_background"
                android:backgroundTint="@null"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:background="#E5E8EB"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGoogleSignup"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="108dp"
                android:background="@drawable/bg_social_google"
                android:backgroundTint="@null"
                android:text="Google로 계속하기"
                android:textAllCaps="false"
                android:textColor="#202124"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp" />
        </LinearLayout>
    </ScrollView>
    <!-- 공통 챗봇 플로팅 버튼 포함 -->
    <include
        layout="@layout/layout_floating_chatbot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
