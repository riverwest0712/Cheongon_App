<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#FFFFFF"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- 상단 파란 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="#2F6FED"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="청온"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="청년의 오늘을 응원합니다"
                android:textColor="#EAF1FF"
                android:textSize="14sp" />
        </LinearLayout>
        <!-- 로그인 전 프로필 영역 -->
        <LinearLayout
            android:id="@+id/layoutLoggedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_drawer_profile"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="로그인이 필요합니다"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="로그인하고 더 많은 서비스를 이용해보세요."
                        android:textColor="#777777"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="로그인"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/btnSignUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_signup_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="회원가입"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <!-- 로그인 후 프로필 영역 -->
        <LinearLayout
            android:id="@+id/layoutLoggedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_drawer_profile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사용자님"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btnMyInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="내 정보 보기 〉"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#EEEEEE" />
        <!-- 홈 -->
        <TextView
            android:id="@+id/drawerHome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            android:drawableStart="@drawable/home_g"
            android:drawablePadding="18dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="홈"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 로그인 후 메뉴 -->
        <LinearLayout
            android:id="@+id/layoutLoginMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <!-- 정책 찾기 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="정책 찾기"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/drawerPolicy"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="조건 설정"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerRecommendation"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="추천 정책"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerBookmark"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="찜한 정책"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerCalendar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="정책 캘린더"
                android:textColor="#555555"
                android:textSize="14sp" />

            <!-- 커뮤니티 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="커뮤니티"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/drawerCommunity"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="게시판"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerMyPosts"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="내가 쓴 게시글"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerMyComments"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="내가 쓴 댓글"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerLikedPosts"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="좋아요 누른 게시물"
                android:textColor="#555555"
                android:textSize="14sp" />

            <!-- 취업 도구 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="취업 도구"
                    android:textColor="#2563EB"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pro_service_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="PRO"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/drawerResume"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="자소서 첨삭"
                android:textColor="#555555"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/drawerInterview"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="면접 질문 생성"
                android:textColor="#555555"
                android:textSize="14sp" />


            <!-- 챗봇 -->
            <TextView
                android:id="@+id/drawerChatbot"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="챗봇"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 설정 -->
            <TextView
                android:id="@+id/drawerSettings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="설정"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="48dp"
                android:paddingEnd="24dp"
                android:text="로그아웃"
                android:textColor="#E53935"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
