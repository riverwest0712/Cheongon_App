<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded" android:backgroundTint="#FFFFFF">

    <!-- 다이얼로그 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="댓글 수정"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#191F28"
        android:layout_marginBottom="16dp" />

    <!-- 입력창 -->
    <EditText
        android:id="@+id/edtEditInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:gravity="top|start"
        android:padding="14dp"
        android:textSize="15sp"
        android:textColor="#333333"
        android:background="@drawable/bg_comment_input"
        android:layout_marginBottom="20dp" />

    <!-- 취소 / 수정 버튼 레이아웃 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="취소"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF3B30"
            android:backgroundTint="#FFEEED"
            android:minWidth="80dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="수정"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:backgroundTint="#EFF6FF"
            android:minWidth="80dp" />

    </LinearLayout>

</LinearLayout>