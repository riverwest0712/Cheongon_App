<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    tools:context=".jobtool.CoverLetterEditActivity">
    <!-- 메인 화면 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- 공통 상단바 -->
        <include
            android:id="@+id/topHeader"
            layout="@layout/top_header"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- 스크롤 영역 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#F7F8FA"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/topHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp" >
                <!-- 타이틀 영역 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" >
                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_back"
                        android:contentDescription="뒤로가기"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:tint="#191F28" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 자소서 첨삭"
                        android:textColor="#191F28"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 1. 자소서 입력 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="자기소개서 내용 입력"
                            android:textColor="#191F28"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="지원동기, 성격의 장단점 등을 자유롭게 작성해주세요."
                            android:textColor="#8B95A1"
                            android:textSize="12sp" />
                        <EditText
                            android:id="@+id/etCoverLetter"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/edittext_background"
                            android:backgroundTint="#FAFAFC"
                            android:gravity="top|start"
                            android:hint="내용을 입력하세요..."
                            android:inputType="textMultiLine"
                            android:padding="14dp"
                            android:textColor="#191F28"
                            android:textSize="14sp" />
                        <!-- 첨삭 요청 버튼 -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnRequestReview"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/logo_background"
                            android:stateListAnimator="@null"
                            android:text="AI 첨삭 받기"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- 로딩바 (초기엔 숨김) -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="20dp"
                    android:visibility="gone"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" />
                <!-- 2. AI 첨삭 결과 카드 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ AI 첨삭 피드백"
                            android:textColor="#2563EB"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvAiResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="#333333"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
        <!-- 공통 하단바 -->
        <include
            android:id="@+id/bottomMenu"
            layout="@layout/bottom_menu"
            android:layout_width="0dp"
            android:layout_height="76dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- 공통 챗봇 플로팅 버튼 -->
        <include
            layout="@layout/layout_floating_chatbot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- 햄버거 메뉴 -->
    <include
        android:id="@+id/drawerMenuInclude"
        layout="@layout/hamburger"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />
</androidx.drawerlayout.widget.DrawerLayout>