<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- 1. 게시글 제목 -->
        <TextView
            android:id="@+id/txtPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#3F7BFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="게시글 제목이 여기에 표시됩니다." />

        <!-- 2. 댓글 본문 내용 -->
        <TextView
            android:id="@+id/txtCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtPostTitle"
            android:layout_marginTop="8dp"
            android:textColor="#222222"
            android:textSize="15sp"
            tools:text="댓글 내용이 들어가는 영역입니다." />

        <!-- 3. 작성 날짜 -->
        <TextView
            android:id="@+id/txtDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtCommentText"
            android:layout_marginTop="12dp"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:textColor="#888888"
            android:textSize="12sp"
            tools:text="2026-09-02" />

        <!-- 4. 수정 / 삭제 버튼 그룹 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtCommentText"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 수정 버튼 -->
            <Button
                android:id="@+id/btnEditComment"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="65dp"
                android:text="수정"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:backgroundTint="#EFF6FF"
                app:cornerRadius="6dp"
                android:gravity="center" />

            <!-- 삭제 버튼 -->
            <Button
                android:id="@+id/btnDeleteComment"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:minWidth="65dp"
                android:text="삭제"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF3B30"
                android:backgroundTint="#FFEEED"
                app:cornerRadius="6dp"
                android:gravity="center" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>