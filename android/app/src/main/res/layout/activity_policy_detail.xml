<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    tools:context=".recommendation.PolicyDetailActivity">

    <!-- =========================
         메인 화면 영역
         ========================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 공통 상단바 -->
        <include
            android:id="@+id/topHeader"
            layout="@layout/top_header"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- =========================
             상세정보 내용 (스크롤 영역)
             ========================= -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:background="#F5F6F8"
            android:clipToPadding="false"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/topHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp" >

                <!-- 상단 타이틀 영역 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" >
                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_back"
                        android:contentDescription="뒤로가기"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:tint="#191F28" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="정책 상세정보"
                        android:textColor="#191F28"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 1. 정책 요약 및 핵심 혜택 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:id="@+id/tvCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="카테고리 &gt; 서브카테고리"
                            android:textColor="#2563EB"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvPolicyTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:text="정책 제목 로딩 중..."
                            android:textColor="#1A1A1A"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- 혜택 금액 강조 배너 -->
                        <LinearLayout
                            android:id="@+id/layoutBenefit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#EFF6FF"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:layout_marginBottom="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="지원 혜택"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvBenefitAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="최대 OOO원 지원"
                                android:textColor="#1E3A8A"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 빠른 정보 박스 (기관, 기간, 신청링크) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#F7F9FC"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvOrganization"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="지원기관: -"
                                android:textColor="#4B5563"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvApplyPeriod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="신청기간: -"
                                android:textColor="#4B5563"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tvApplyLink"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="신청 링크: 바로가기 →"
                                android:autoLink="web"
                                android:textColor="#2563EB"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. 지원 내용 및 소개 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="지원 내용"
                            android:textColor="#191F28"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvSupportContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="#4B5563"
                            android:textSize="14sp"
                            android:text="지원 내용 상세 설명이 들어갑니다." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E5E7EB"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="정책 소개 및 개요"
                            android:textColor="#191F28"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="#6B7280"
                            android:textSize="13sp"
                            android:text="정책 요약 설명" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. 지원 자격 및 조건 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="신청 자격 및 조건"
                            android:textColor="#191F28"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- 자격 요약 칩/텍스트들 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F9FAFB"
                            android:padding="14dp"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:id="@+id/tvAgeRange"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:textColor="#374151"
                                android:textSize="13sp"
                                android:text="• 연령 조건: -" />
                            <TextView
                                android:id="@+id/tvIncomeCondition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:textColor="#374151"
                                android:textSize="13sp"
                                android:text="• 소득 조건: -" />
                            <TextView
                                android:id="@+id/tvEmploymentCondition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:textColor="#374151"
                                android:textSize="13sp"
                                android:text="• 취업 상태: -" />
                            <TextView
                                android:id="@+id/tvRegion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#374151"
                                android:textSize="13sp"
                                android:text="• 지역 조건: -" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvApplyCondition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="#4B5563"
                            android:textSize="13sp"
                            android:text="상세 신청 자격 내용" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. 신청 방법 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="신청 방법"
                            android:textColor="#191F28"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvApplicationMethod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:textColor="#4B5563"
                            android:textSize="14sp"
                            android:text="신청 방법 안내" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- =========================
                     중앙 하단 찜(추천) 버튼 영역
                     ========================= -->
                <LinearLayout
                    android:id="@+id/layoutLike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/bg_round"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" >

                    <!-- 파란 하늘색 동그라미 배경 박스 -->
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/circle"
                        android:backgroundTint="#F8F9FC">

                        <!-- 빈 하트 / 채워진 하트 아이콘 -->
                        <ImageView
                            android:id="@+id/imgLike"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:clickable="false"
                            android:focusable="false"
                            android:src="@drawable/ic_favorite_border"
                            app:tint="#2563EB"
                            android:contentDescription="찜하기 버튼" />
                    </FrameLayout>

                    <!-- 하트 아래 찜 개수 텍스트 -->
                    <TextView
                        android:id="@+id/txtLikeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:textColor="#2563EB"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="0" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 공통 하단바 -->
        <include
            android:id="@+id/bottomMenu"
            layout="@layout/bottom_menu"
            android:layout_width="0dp"
            android:layout_height="76dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 공통 챗봇 플로팅 버튼 포함 -->
        <include
            layout="@layout/layout_floating_chatbot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 햄버거 메뉴 -->
    <include
        android:id="@+id/drawerMenuInclude"
        layout="@layout/hamburger"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>