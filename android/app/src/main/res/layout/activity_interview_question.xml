<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    tools:ignore="HardcodedText">
    <!-- 메인 화면 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- 공통 상단바 -->
        <include
            android:id="@+id/topHeader"
            layout="@layout/top_header"
            android:layout_width="0dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- 스크롤 영역 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#F7F8FA"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/topHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F6F8"
                android:paddingBottom="20dp">
                <!-- 타이틀 영역 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="#F5F6F8">
                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_back"
                        android:contentDescription="뒤로가기"
                        android:padding="14dp"
                        android:scaleType="fitCenter"
                        android:tint="#191F28" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="면접 질문 생성"
                        android:textColor="#191F28"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 1. 면접 준비 정보 입력 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="면접 준비 정보 입력"
                            android:textColor="#191F28"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="지원 직무와 경력, 필요 역량과 경험을 바탕으로 예상 질문을 생성해요. 회사·산업 정보는 선택 입력이에요."
                            android:textColor="#8B95A1"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:labelFor="@+id/etJobRole"
                            android:text="지원 직무 (필수)"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etJobRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_background"
                            android:hint="예: 안드로이드 개발자, 마케팅"
                            android:inputType="text"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:padding="14dp"
                            android:textColor="#191F28"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:labelFor="@+id/etCareerLevel"
                            android:text="경력 수준 (필수)"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etCareerLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_background"
                            android:hint="예: 신입, 경력 3년"
                            android:inputType="text"
                            android:imeOptions="actionNext"
                            android:maxLines="1"
                            android:padding="14dp"
                            android:textColor="#191F28"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:labelFor="@+id/etRequiredCompetencies"
                            android:text="채용공고·필요 역량 (필수)"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etRequiredCompetencies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="120dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_background"
                            android:gravity="top|start"
                            android:hint="채용공고의 자격 요건·우대 사항을 붙여넣거나 직접 적어주세요. 예: Kotlin 활용 능력, 문제 해결 능력, 협업 및 의사소통 능력"
                            android:inputType="textMultiLine"
                            android:padding="14dp"
                            android:textColor="#191F28"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:labelFor="@+id/etCoverLetter"
                            android:text="자기소개서·주요 경험 (필수)"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etCoverLetter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="200dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_background"
                            android:backgroundTint="#FAFAFC"
                            android:gravity="top|start"
                            android:hint="자기소개서나 이력서의 경험을 적어주세요. 자기소개서가 없어도 프로젝트·활동에서 맡은 역할, 해결한 문제, 성과를 적으면 돼요."
                            android:inputType="textMultiLine"
                            android:padding="14dp"
                            android:textColor="#191F28"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:labelFor="@+id/etCompanyIndustry"
                            android:text="지원 회사·산업 (선택)"
                            android:textColor="#191F28"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <EditText
                            android:id="@+id/etCompanyIndustry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/edittext_background"
                            android:hint="예: ○○은행 / 금융·핀테크"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:padding="14dp"
                            android:textColor="#191F28"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="회사명이나 산업 분야 중 아는 내용만 적어주세요."
                            android:textColor="#8B95A1"
                            android:textSize="12sp" />
                        <!-- 질문 생성 요청 버튼 -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnGenerateQuestions"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/logo_background"
                            android:stateListAnimator="@null"
                            android:text="AI 면접 질문 생성하기"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- 로딩바 (초기엔 숨김) -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="20dp"
                    android:visibility="gone" />
                <!-- 2. AI 면접 질문 결과 카드 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardResult"
                    tools:visibility="visible"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="80dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="예상 면접 질문"
                            android:textColor="#2563EB"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvInterviewQuestions"
                            android:textIsSelectable="true"
                            android:accessibilityLiveRegion="polite"
                            tools:text="1. 지원 직무에 관심을 갖게 된 계기는 무엇인가요?&#xA;&#xA;2. 프로젝트에서 가장 어려웠던 문제와 해결 과정을 설명해주세요.&#xA;&#xA;3. 협업 중 의견 차이를 조율한 경험이 있나요?"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="#333333"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
        <!-- 공통 하단바 -->
        <include
            android:id="@+id/bottomMenu"
            layout="@layout/bottom_menu"
            android:layout_width="0dp"
            android:layout_height="76dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- 공통 챗봇 플로팅 버튼 -->
        <include
            layout="@layout/layout_floating_chatbot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- 햄버거 메뉴 -->
    <include
        android:id="@+id/drawerMenuInclude"
        layout="@layout/hamburger"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />
</androidx.drawerlayout.widget.DrawerLayout>