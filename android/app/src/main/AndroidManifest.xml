<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">
        <activity
            android:name=".main.Main"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".login.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".login.SignupActivity"
            android:exported="false" />

        <activity
            android:name=".login.GoogleSignupActivity"
            android:exported="false" />

        <activity
            android:name=".login.FindPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".recommendation.RecommendationActivity"
            tools:ignore="Instantiatable" />

        <activity
            android:name=".recommendation.ConditionInputActivity"
            android:exported="false" />
        <activity
            android:name=".recommendation.IncomeCalculatorActivity"
            android:exported="false" />
        <activity
            android:name=".recommendation.PolicyDetailActivity"
            android:exported="false" />

        <activity
            android:name=".mypage.ChatbotActivity"
            android:exported="false" />

        <activity
            android:name=".mypage.MyPageActivity"
            android:exported="false"/>

        <activity android:name=".mypage.CalendarActivity"
            android:exported="false" />

        <activity
            android:name=".recommendation.BookmarkActivity"
            android:exported="false" />

        <activity
            android:name=".community.BoardActivity"
            android:exported="false" />

        <activity
            android:name=".community.PostWriteActivity"
            android:exported="false" />

        <activity
            android:name=".community.PostDetailActivity"
            android:exported="false"/>

        <activity
            android:name=".community.MyPostsActivity"
            android:exported="false" />

        <activity
            android:name=".community.MyCommentsActivity"
            android:exported="false" />

        <activity
            android:name=".community.LikedPostsActivity"
            android:exported="false" />

        <activity
            android:name=".jobtool.CoverLetterEditActivity"
            android:exported="false" />

        <activity
            android:name=".jobtool.InterviewQuestionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".mypage.NotificationActivity"
            android:exported="false" />

        <activity
            android:name=".main.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".main.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".jobtool.JobToolActivity"
            android:exported="false" />

        <activity
            android:name=".jobtool.JobtoolPaymentActivity"
            android:exported="false" />

    </application>

</manifest>
